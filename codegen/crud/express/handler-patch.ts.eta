<%
const n = it.names;
const op = it.crud.operations.find((item) => item.kind === 'update');
const proc = `process${it.h.upperFirst(op.name)}`;
const name = `patch${n.Entity}Handler`;
const fields = `[${it.columns.map((column) => `'${column.name}'`).join(', ')}]`;
-%>
import type { Request, Response } from 'express';
import { getManagedCanonicalDataClient } from '../../canonical-data-client';
import { pickFields } from '../../../utils/http/pick-fields';
import { <%= proc %> } from '../process-<%= op.file %>';

/** PATCH /api/data/<%= n.folder %>/:id */
export const <%= name %> = async (req: Request, res: Response): Promise<void> => {
  console.log('📥 [<%= n.folder %>.<%= name %>]', { params: req.params, query: req.query });
  try {
    const client = getManagedCanonicalDataClient();
    if (!client) {
      res.status(500).json({ success: false, error: 'Storage client unavailable' });
      return;
    }
    const id = typeof req.params.id === 'string' ? req.params.id.trim() : '';
    const input = pickFields(req.body, <%= fields %>);
    if (!id || Object.keys(input).length === 0) {
      res.status(400).json({ success: false, error: 'id and at least one field are required' });
      return;
    }
    const data = await <%= proc %>(client, id, input as Parameters<typeof <%= proc %>>[2]);
    if (!data) {
      res.status(404).json({ success: false, error: '<%= n.Entity %> not found' });
      return;
    }
    res.status(200).json({ success: true, data });
  } catch (error) {
    console.error('❌ [<%= n.folder %>.<%= name %>]', error);
    res.status(500).json({ success: false, error: error instanceof Error ? error.message : 'Unknown error' });
  }
};
