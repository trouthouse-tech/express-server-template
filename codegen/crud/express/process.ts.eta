<%
/* src/services/{folder}/process-{operation}.ts: where business rules for the table go (api.svc.process_functions). */
const E = it.names.Entity;
const op = it.op;
const sig = {
  list: { params: '', args: '[]', ret: `${E}[]`, types: [E] },
  list_by: { params: `, ${op.column}: string`, args: `[${op.column}]`, ret: `${E}[]`, types: [E] },
  get_by_id: { params: ', id: string', args: '[id]', ret: `${E} | null`, types: [E] },
  create: { params: `, input: Create${E}Input`, args: '[input]', ret: E, types: [`Create${E}Input`, E] },
  update: { params: `, id: string, input: Update${E}Input`, args: '[id, input]', ret: `${E} | null`, types: [E, `Update${E}Input`] },
  delete: { params: ', id: string', args: '[id]', ret: 'boolean', types: [] },
}[op.kind];
const argNames = sig.args.replace(/^\[|\]$/g, '');
-%>
import { <%= op.name %> } from '../../data/<%= it.names.folder %>';
<% if (sig.types.length > 0) { -%>
import type { <%= sig.types.join(', ') %> } from '../../model/<%= it.names.entity %>';
<% } -%>
import type { CanonicalDataClient } from '../canonical-data-client';

/**
 * <%= op.name %> (business rules for <%= it.names.table %> go here).
 */
export const process<%= it.h.upperFirst(op.name) %> = async (client: CanonicalDataClient<%= sig.params %>): Promise<<%= sig.ret %>> =>
  <%= op.name %>(client<%= argNames ? `, ${argNames}` : '' %>);
