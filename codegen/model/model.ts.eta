<%
/* src/model/{entity}/index.ts: enum unions, the row type (standard columns first), Create/Update inputs. Types only. */
const E = it.names.Entity;
const unionName = (column) => `${E}${it.h.pascal(column.name)}`;
const fieldType = (column) => {
  const base = column.enum_values.length > 0 ? unionName(column) : column.ts_type;
  return column.not_null ? base : `${base} | null`;
};
const doc = (text, indent = '') => {
  const value = it.h.docText(text);
  return value ? `${indent}/** ${value} */\n` : '';
};
const requiredOnCreate = (column) => column.not_null && !column.default_sql.trim();
-%>
// Generated by Code Control from the approved data model. Identical in storage, express and web.

<% for (const column of it.columns.filter((c) => c.enum_values.length > 0)) { -%>
<%= doc(`Allowed values for ${it.table.name}.${column.name}.`) %>export type <%= unionName(column) %> = <%= column.enum_values.map((value) => it.h.tsQuote(value)).join(' | ') %>;

<% } -%>
<%= doc(`Row in ${it.table.name}. ${it.table.purpose}`) %>export type <%= E %> = {
<% for (const column of it.standard_columns) { -%>
  <%= column.name %>: <%= column.ts_type.trim() || 'string' %>;
<% } -%>
<% for (const column of it.columns) { -%>
<%= doc(column.description, '  ') %>  <%= column.name %>: <%= fieldType(column) %>;
<% } -%>
};

<%= doc(`Input for create${E}.`) %>export type Create<%= E %>Input = {
<% for (const column of it.columns) { -%>
  <%= column.name %><%= requiredOnCreate(column) ? '' : '?' %>: <%= fieldType(column) %>;
<% } -%>
};

<%= doc(`Input for update${E} (only the fields to change).`) %>export type Update<%= E %>Input = {
<% for (const column of it.columns) { -%>
  <%= column.name %>?: <%= fieldType(column) %>;
<% } -%>
};
