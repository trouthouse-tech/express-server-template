/**
 * Project values for this dispatcher. Generated by Code Control from the software system's
 * dispatcher plan (ADR 014); every other file reads them from here.
 */

/** Gateway catalog project id (`/{PROJECT_ID}/api/...` on the main gateway). */
export const PROJECT_ID = <%~ it.h.tsQuote(it.dispatcher.project_id) %>;
export const PROJECT_NAME = <%~ it.h.tsQuote(it.dispatcher.name) %>;

/** Registry ids in dispatcher.services.json. */
export const STORAGE_SERVICE_ID = <%~ it.h.tsQuote(it.dispatcher.service_ids.storage) %>;
export const API_SERVICE_ID = <%~ it.h.tsQuote(it.dispatcher.service_ids.api) %>;

/** Env var holding the storage secret (same value as STORAGE_DISPATCHER_SECRET in the storage repo). */
export const STORAGE_SECRET_ENV_VAR = <%~ it.h.tsQuote(it.dispatcher.secrets.storage) %>;

/** Loopback port this dispatcher listens on when PORT is unset. */
export const DEFAULT_PORT = <%= it.dispatcher.ports.dispatcher %>;

/** Dispatcher web port, allowed by CORS when WEB_APP_ORIGIN is unset. */
export const DISPATCHER_WEB_PORT = <%= it.dispatcher.ports.web %>;
