{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "services"],
  "properties": {
    "version": { "const": 1 },
    "gatewayPublicPaths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/definitions/service" }
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "required": ["id", "pathPrefix", "upstreamBaseUrl", "healthPath", "upstreamAuth"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "displayName": { "type": "string" },
        "pathPrefix": { "type": "string" },
        "upstreamBaseUrl": { "type": "string" },
        "healthPath": { "type": "string" },
        "healthIsPublic": { "type": "boolean" },
        "upstreamAuth": { "type": "object" },
        "spawn": {
          "type": "object",
          "properties": {
            "credentials": {
              "type": "array",
              "description": "Runtime-issued secrets: generated in memory by this dispatcher and injected into the child env at spawn. No .env entry needed.",
              "items": {
                "type": "object",
                "required": ["name", "childEnv"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
                  "childEnv": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
                }
              }
            }
          }
        },
        "proxyPathsAllowlist": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
