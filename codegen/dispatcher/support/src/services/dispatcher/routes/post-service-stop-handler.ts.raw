import type { Request, Response } from 'express';
import { processStopService } from '../process-stop-service';

/**
 * POST /api/dispatcher/services/:id/stop
 */
export const postServiceStopHandler = async (req: Request, res: Response): Promise<void> => {
  const serviceId = String(req.params.id ?? '');
  if (!serviceId) {
    res.status(400).json({ success: false, error: 'Missing service id' });
    return;
  }
  try {
    const data = await processStopService(serviceId);
    res.status(200).json({ success: true, data });
  } catch (error) {
    console.error('❌ [dispatcher] stop service:', error);
    res.status(500).json({ success: false, error: 'Failed to stop service' });
  }
};
