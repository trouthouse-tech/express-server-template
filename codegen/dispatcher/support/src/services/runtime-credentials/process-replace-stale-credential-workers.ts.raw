import { getRegistrySnapshot } from '../registry/registry-snapshot';
import { stopService } from '../worker-lifecycle/stop-service';
import { readWorkerManifest } from '../worker-lifecycle/worker-manifest-io';
import { needsCredentialRefresh } from './needs-credential-refresh';

/**
 * Startup: storage/API workers left by a previous dispatcher process hold credentials this
 * process never issued. Stop them; they respawn lazily with fresh credentials.
 */
export const processReplaceStaleCredentialWorkers = async (): Promise<void> => {
  for (const service of getRegistrySnapshot().file.services) {
    const manifest = readWorkerManifest(service.id);
    if (!needsCredentialRefresh(service.id, service.spawn?.credentials, manifest?.pid)) {
      continue;
    }
    console.log(`📤 [runtime-credentials] Stopping ${service.id} (credentials from previous dispatcher process)`);
    try {
      await stopService(service.id);
    } catch (error) {
      console.error(`❌ [runtime-credentials] Stop failed for ${service.id}:`, error);
    }
  }
};
