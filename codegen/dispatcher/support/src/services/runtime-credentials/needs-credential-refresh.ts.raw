import type { SpawnCredential } from '../../model/spawn-credential';
import { wasCredentialDeliveredTo } from './runtime-credential-store';

/**
 * True when a running worker declares credentials but did not receive them from this process
 * (typically: the parent restarted and the worker still holds the previous values).
 */
export const needsCredentialRefresh = (
  workerId: string,
  credentials: SpawnCredential[] | undefined,
  pid: number | null | undefined,
): boolean => {
  if (!credentials?.length || !pid) {
    return false;
  }
  return !wasCredentialDeliveredTo(workerId, pid);
};
