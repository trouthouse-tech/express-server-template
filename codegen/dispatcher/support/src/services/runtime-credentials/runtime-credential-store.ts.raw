import { randomBytes } from 'node:crypto';

/**
 * In-memory runtime credentials (ADR 015 in on-device-dispatcher). Values are never written to disk and end with this
 * process: a gateway restart issues new values and replaces workers that hold old ones.
 */
const values = new Map<string, string>();

/** workerId → pid of the process that received this process's credentials at spawn. */
const deliveries = new Map<string, number>();

/**
 * Returns the runtime credential for `name`, generating 256 random bits on first use.
 * The same value is reused for every spawn while this process lives, so a child that restarts
 * (e.g. storage after idle shutdown) still matches siblings that hold the same secret.
 */
export const getOrCreateRuntimeCredential = (name: string): string => {
  const existing = values.get(name);
  if (existing) {
    return existing;
  }
  const created = randomBytes(32).toString('base64url');
  values.set(name, created);
  return created;
};

export const recordCredentialDelivery = (workerId: string, pid: number): void => {
  deliveries.set(workerId, pid);
};

export const clearCredentialDelivery = (workerId: string): void => {
  deliveries.delete(workerId);
};

export const wasCredentialDeliveredTo = (workerId: string, pid: number): boolean =>
  deliveries.get(workerId) === pid;

/** Test-only reset. */
export const resetRuntimeCredentialsForTests = (): void => {
  values.clear();
  deliveries.clear();
};
