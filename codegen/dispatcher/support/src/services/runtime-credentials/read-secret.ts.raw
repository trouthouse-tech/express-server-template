import { listDeclaredCredentialNames } from './list-declared-credential-names';
import { getOrCreateRuntimeCredential } from './runtime-credential-store';

/**
 * Resolves a parent-side secret by name. Names declared in a spawn `credentials` block are
 * runtime-issued (env is ignored); anything else falls back to process.env so projects that
 * have not migrated keep working from `.env`.
 */
export const readSecret = (name: string): string | undefined => {
  if (listDeclaredCredentialNames().has(name)) {
    return getOrCreateRuntimeCredential(name);
  }
  const value = process.env[name]?.trim();
  return value || undefined;
};
