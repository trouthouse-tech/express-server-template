import { getRegistrySnapshot } from '../registry/registry-snapshot';

/**
 * Every credential name declared on this dispatcher's registry spawn configs.
 */
export const listDeclaredCredentialNames = (): Set<string> => {
  const names = new Set<string>();
  let services;
  try {
    services = getRegistrySnapshot().file.services;
  } catch {
    return names;
  }
  for (const service of services) {
    for (const credential of service.spawn?.credentials ?? []) {
      names.add(credential.name);
    }
  }
  return names;
};
