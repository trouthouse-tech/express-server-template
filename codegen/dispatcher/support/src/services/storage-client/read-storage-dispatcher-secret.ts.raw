import { STORAGE_SECRET_ENV_VAR } from '../../config/project';
import { readSecret } from '../runtime-credentials';

/**
 * Secret sent as x-storage-secret to storage express. Runtime-issued when the storage service declares
 * it in spawn.credentials; otherwise read from env (must match STORAGE_DISPATCHER_SECRET in the storage repo).
 */
export const readStorageDispatcherSecret = (): string => {
  const secret = readSecret(STORAGE_SECRET_ENV_VAR) || process.env.STORAGE_DISPATCHER_SECRET?.trim();
  if (!secret) {
    throw new Error(`${STORAGE_SECRET_ENV_VAR} is not configured`);
  }
  return secret;
};
