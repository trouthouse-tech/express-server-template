import { STORAGE_SECRET_ENV_VAR } from '../../config/project';

/**
 * Secret sent as x-storage-secret to storage express (must match STORAGE_DISPATCHER_SECRET in the storage repo).
 */
export const readStorageDispatcherSecret = (): string => {
  const secret = process.env[STORAGE_SECRET_ENV_VAR]?.trim() || process.env.STORAGE_DISPATCHER_SECRET?.trim();
  if (!secret) {
    throw new Error(`${STORAGE_SECRET_ENV_VAR} is not configured`);
  }
  return secret;
};
