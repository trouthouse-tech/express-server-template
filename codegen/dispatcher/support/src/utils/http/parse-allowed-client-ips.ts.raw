/**
 * Parses DISPATCHER_ALLOWED_CLIENT_IPS into a set (empty = allow all).
 */
export const parseAllowedClientIps = (raw: string | undefined): Set<string> | null => {
  const trimmed = raw?.trim();
  if (!trimmed) {
    return null;
  }
  const ips = trimmed
    .split(',')
    .map((ip) => ip.trim())
    .filter((ip) => ip.length > 0);
  return new Set(ips);
};
