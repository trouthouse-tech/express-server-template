-- Worker session tables for gateway project <%= it.dispatcher.project_id %> (main gateway ADR 012).
-- Generated by Code Control.

CREATE TABLE IF NOT EXISTS <%= it.dispatcher.session_slug %>_dispatcher_sessions (
  id bigserial PRIMARY KEY,
  pid integer,
  upstream_url text NOT NULL,
  log_path text,
  status text NOT NULL,
  started_at timestamptz NOT NULL,
  last_activity_at timestamptz NOT NULL,
  ended_at timestamptz,
  spawn_trigger text,
  spawn_client_ip text,
  spawn_request_method text,
  spawn_request_path text,
  CONSTRAINT <%= it.dispatcher.session_slug %>_dispatcher_sessions_status_check
    CHECK (status IN ('starting', 'active', 'stopped', 'stale', 'failed', 'superseded'))
);

CREATE UNIQUE INDEX IF NOT EXISTS <%= it.dispatcher.session_slug %>_dispatcher_sessions_one_live
  ON <%= it.dispatcher.session_slug %>_dispatcher_sessions ((1))
  WHERE status IN ('starting', 'active');

CREATE INDEX IF NOT EXISTS <%= it.dispatcher.session_slug %>_dispatcher_sessions_active_idle
  ON <%= it.dispatcher.session_slug %>_dispatcher_sessions (last_activity_at)
  WHERE status = 'active';

