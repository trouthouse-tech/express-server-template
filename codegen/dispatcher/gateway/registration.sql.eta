-- <%= it.dispatcher.name %> project dispatcher registration on the main gateway (on_device_gateway).
-- Generated by Code Control. Secrets are runtime credentials (ADR 015): the gateway generates them in
-- memory and injects them at spawn. No .env values needed.

INSERT INTO registry_services (
  id,
  display_name,
  path_prefix,
  upstream_base_url,
  health_path,
  health_is_public,
  upstream_auth,
  proxy_paths_allowlist,
  spawn,
  notes
) VALUES (
  <%~ it.h.sqlQuote(it.dispatcher.service_ids.gateway) %>,
  <%~ it.h.sqlQuote(it.dispatcher.name + ' Project Dispatcher') %>,
  <%~ it.h.sqlQuote(it.dispatcher.gateway_path_prefix) %>,
  'http://127.0.0.1:<%= it.dispatcher.ports.dispatcher %>',
  '/api/health',
  true,
  <%~ it.h.sqlQuote(JSON.stringify({ mode: 'inject-from-env', header: 'x-dispatcher-gate-secret', envVar: it.dispatcher.secrets.main_gate })) %>::jsonb,
  '[]'::jsonb,
  <%~ it.h.sqlQuote(JSON.stringify({ cwd: it.dispatcher.cwd.dispatcher, startCommand: 'npm run dev', env: { PORT: String(it.dispatcher.ports.dispatcher), DISPATCHER_BIND_HOST: '127.0.0.1' }, credentials: [{ name: it.dispatcher.secrets.main_gate, childEnv: 'DISPATCHER_GATE_SECRET' }, { name: it.dispatcher.secrets.main_admin, childEnv: 'DISPATCHER_INFRA_ADMIN_SECRET' }] })) %>::jsonb,
  <%~ it.h.sqlQuote('Project dispatcher on ' + it.dispatcher.ports.dispatcher + '; storage ' + it.dispatcher.ports.storage + ' and API ' + it.dispatcher.ports.api + ' spawn there.') %>
)
ON CONFLICT (id) DO UPDATE SET
  display_name = EXCLUDED.display_name,
  path_prefix = EXCLUDED.path_prefix,
  upstream_base_url = EXCLUDED.upstream_base_url,
  health_path = EXCLUDED.health_path,
  health_is_public = EXCLUDED.health_is_public,
  upstream_auth = EXCLUDED.upstream_auth,
  proxy_paths_allowlist = EXCLUDED.proxy_paths_allowlist,
  spawn = EXCLUDED.spawn,
  notes = EXCLUDED.notes,
  updated_at = now();

INSERT INTO gateway_projects (
  id,
  name,
  description,
  service_id,
  repo_hint,
  dispatcher_web_url,
  dispatcher_web_spawn,
  child_base_url,
  child_admin_secret_env_var,
  child_gate_secret_env_var,
  child_storage_service_id
) VALUES (
  <%~ it.h.sqlQuote(it.dispatcher.project_id) %>,
  <%~ it.h.sqlQuote(it.dispatcher.name) %>,
  <%~ it.h.sqlQuote(it.dispatcher.description) %>,
  <%~ it.h.sqlQuote(it.dispatcher.service_ids.gateway) %>,
  <%~ it.h.sqlQuote(it.dispatcher.repos.dispatcher) %>,
  'http://127.0.0.1:<%= it.dispatcher.ports.web %>',
  <%~ it.h.sqlQuote(JSON.stringify({ cwd: it.dispatcher.cwd.dispatcher_web, startCommand: 'npm run dev', credentials: [{ name: it.dispatcher.secrets.main_admin, childEnv: 'DISPATCHER_INFRA_ADMIN_SECRET' }] })) %>::jsonb,
  'http://127.0.0.1:<%= it.dispatcher.ports.dispatcher %>',
  <%~ it.h.sqlQuote(it.dispatcher.secrets.main_admin) %>,
  <%~ it.h.sqlQuote(it.dispatcher.secrets.main_gate) %>,
  <%~ it.h.sqlQuote(it.dispatcher.service_ids.storage) %>
)
ON CONFLICT (id) DO UPDATE SET
  name = EXCLUDED.name,
  description = EXCLUDED.description,
  service_id = EXCLUDED.service_id,
  repo_hint = EXCLUDED.repo_hint,
  dispatcher_web_url = EXCLUDED.dispatcher_web_url,
  dispatcher_web_spawn = EXCLUDED.dispatcher_web_spawn,
  child_base_url = EXCLUDED.child_base_url,
  child_admin_secret_env_var = EXCLUDED.child_admin_secret_env_var,
  child_gate_secret_env_var = EXCLUDED.child_gate_secret_env_var,
  child_storage_service_id = EXCLUDED.child_storage_service_id,
  updated_at = now();
