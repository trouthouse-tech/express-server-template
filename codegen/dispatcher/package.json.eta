{
  "name": <%~ it.h.json(it.dispatcher.repos.dispatcher) %>,
  "version": "1.0.0",
  "description": <%~ it.h.json(it.dispatcher.name + ' project dispatcher') %>,
  "main": "index.ts",
  "scripts": {
    "start": "ts-node index.ts",
    "dev": "nodemon --config nodemon.json --exec ts-node index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "22.x"
  }
}
