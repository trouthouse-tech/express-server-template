PORT=<%= it.dispatcher.ports.dispatcher %>
NODE_ENV=development
DISPATCHER_BIND_HOST=127.0.0.1
DISPATCHER_SERVICES_REGISTRY_PATH=./dispatcher.services.json
DISPATCHER_PROJECTS_PATH=./dispatcher.projects.json
# Exposed endpoint rows are loaded from storage express (<%= it.dispatcher.ports.storage %>) over HTTP: no DATABASE_URL on this service.
DISPATCHER_PUBLIC_BASE_URL=http://127.0.0.1:3010
# Same value as <%= it.dispatcher.secrets.main_gate %> on the main gateway
DISPATCHER_GATE_SECRET=
MAIN_GATEWAY_URL=http://127.0.0.1:3010
MAIN_GATEWAY_PROJECT_ID=<%= it.dispatcher.project_id %>
# true skips the gate secret check entirely: local debugging only
DISPATCHER_GATE_INSECURE_ALLOW=false
# Same value as <%= it.dispatcher.secrets.main_admin %> on the main gateway
DISPATCHER_INFRA_ADMIN_SECRET=
DISPATCHER_ALLOWED_CLIENT_IPS=
DISPATCHER_SPAWN_ROOTS=<%= it.dispatcher.spawn_root %>
DISPATCHER_SHELL_INIT=
# Must match STORAGE_DISPATCHER_SECRET in <%= it.dispatcher.repos.storage %>
<%= it.dispatcher.secrets.storage %>=
WEB_APP_ORIGIN=http://127.0.0.1:<%= it.dispatcher.ports.web %>
DISPATCHER_SPAWN_HEALTH_TIMEOUT_MS=120000
DISPATCHER_PROXY_TIMEOUT_MS=120000
DISPATCHER_MAX_CONCURRENT_STARTS=2
# Spawns per service per minute (parallel gateway invokes + ephemeral restarts)
DISPATCHER_RATE_LIMIT_SPAWN_PER_MIN=30
DISPATCHER_STOP_STORAGE_AFTER_CATALOG=true
DISPATCHER_STOP_WORKERS_AFTER_PROXY=true
